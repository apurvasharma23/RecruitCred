# RecruitCred Environment Configuration Template
# Copy this file to .env and provide your deployment's real email credentials.

# Application Secrets
JWT_SECRET=recruitcred_secure_jwt_secret_key_2026_9482
OTP_SALT=rc_otp_salt_v1

# ==============================================================================
# REAL EMAIL DELIVERY CONFIGURATION
# Choose EITHER Option 1 (Transactional API) OR Option 2 (SMTP / Gmail App Password)
# ==============================================================================

# OPTION 1: Transactional Email API (Resend, SendGrid, Brevo, Postmark)
# ------------------------------------------------------------------------------
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=re_123456789abcdef
# EMAIL_FROM="RecruitCred Security" <onboarding@resend.dev>

# OPTION 2: SMTP / Google Gmail App Password (Recommended for quick deployment)
# ------------------------------------------------------------------------------
# Step 1: In your Google Account -> Security -> 2-Step Verification -> App Passwords
# Step 2: Generate a 16-character App Password (e.g., 'abcd efgh ijkl mnop')
# Step 3: Fill in the variables below:
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="RecruitCred Security" <security@recruitcred.dev>

# Optional Custom SMTP Host/Port (for Amazon SES, Brevo SMTP, Mailgun, etc.):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Optional Domain Blocklist (comma-separated disposable/spam domains to reject)
# BLOCKED_EMAIL_DOMAINS=tempmail.com,trashmail.com
