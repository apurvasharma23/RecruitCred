# ==============================================================================
# RecruitCred Environment Variables Template
# ==============================================================================
# Copy this file to `.env` and fill in your actual Razorpay keys & secrets.

# Application Configuration
VITE_APP_NAME="RecruitCred"
VITE_APP_ENV="development"
VITE_APP_URL="http://localhost:5173"

# AI Assistant (CredAI) - Optional External Provider / Backend Proxy
# If unset, CredAI operates using its built-in contextual rule engine.
VITE_AI_API_URL=""
VITE_AI_API_KEY=""

# ==============================================================================
# RecruitCred Pro Subscription & Payment Gateway (Razorpay INR - ₹10/month)
# ==============================================================================
# Public client gateway key for INR 10/month subscriptions (Key ID from Razorpay Dashboard)
VITE_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
VITE_PAYMENT_MODE="test" # 'test' for sandbox mode, 'live' for production

# Server-side & Backend secrets (NEVER expose to client code / React bundle)
PAYMENT_KEY_ID="rzp_test_YOUR_KEY_ID"
PAYMENT_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"
PAYMENT_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"
PAYMENT_PLAN_ID="plan_rc_pro_monthly_10"
PAYMENT_MODE="test"

# Merchant Settlement Destination (Server-configured; payments settle to owner)
PAYMENT_MERCHANT_UPI="6005420014@ybl"

